# china-eaip 统一站点
# 使用方式: docker compose up -d 后由 caddy run --config /etc/caddy/Caddyfile 加载
#
# 一个域名下同时提供三类内容:
#   /                                      -> 数据集前端 (bun-dist, Vue SPA)
#   /api /docs /redoc /openapi.json        -> 数据集后台 FastAPI (backend:8000)
#   /admin /static                         -> Django admin 及其静态文件
#   /EAIP2026-10.V1.4_Web/...              -> raw/*.zip 解压出的离线 eAIP 网页包
#
# 各期 AIP 的 zip 由 extract 服务解压到 content/, 再以 /aip 只读挂载给 caddy。
# 数据包必须挂在根路径: eAIP 前端是 vue-router history 模式且未设置 base,
# 放到 /aip/ 之类的前缀下会让站内跳转丢失前缀。

:80 {
	# ===== 数据集后台 (FastAPI + Django admin) =====
	@backend path /api/* /docs /docs/* /redoc /redoc/* /openapi.json /admin /admin/* /static/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# ===== raw/*.zip 解压后的 AIP 网页包 =====
	# 背景: 各期 AIP 解压后, HtmlTemplate 下的 html 目录名大小写不一致
	#       (部分版本为 Html, 部分为 HTML), 而页面/书签中链接统一使用 Html,
	#       导致访问 HTML 目录的版本时返回 404。这里通过 try_files 做
	#       "先尝试 HTML 变体, 不存在则回退到 Html" 的存在性探测, 兼容两种命名。
	@aip path /EAIP*
	handle @aip {
		root * /aip

		# ===== 缓存策略: 数据包内容带版本号, 缓存 365 天 (60*60*24*365 = 31536000 秒) =====
		# 带内容 hash 的静态资源(js/css/图片/字体等文件名含 8 位以上 hex, 内容不可变)
		# 额外附加 immutable, 缓存期内浏览器不再重新验证。
		@hashed path_regexp \.[0-9a-f]{8,}\.(?:js|css|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|ico)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# 其余所有文件(HTML/JSON/Data 等): 同样缓存 365 天
		@plain not path_regexp \.[0-9a-f]{8,}\.(?:js|css|png|jpe?g|gif|svg|webp|woff2?|ttf|eot|ico)$
		header @plain Cache-Control "public, max-age=31536000"

		# 匹配 HtmlTemplate 下的 html 目录(大小写不敏感, 覆盖 Html / HTML / html 等写法)
		@htmldir path_regexp ^(/EAIP\d{4}-[^/]+_Web/Data/[^/]+/HtmlTemplate/)(?i:html)(/.*)?$
		handle @htmldir {
			# 依次探测: 全大写 HTML → 标准写法 Html; 命中第一个在磁盘上真实存在的路径
			try_files {re.1}HTML{re.2} {re.1}Html{re.2}
		}

		file_server browse
	}

	# ===== 数据集前端 (Vue SPA) =====
	handle {
		root * /srv

		# 入口页必须每次回源校验, 否则前端发版后浏览器仍用旧 index.html
		@entry path / /index.html
		header @entry Cache-Control "no-cache"
		# vite 构建产物带内容 hash, 内容不可变
		@asset path /assets/*
		header @asset Cache-Control "public, max-age=31536000, immutable"

		file_server
		try_files {path} /index.html
	}
}
